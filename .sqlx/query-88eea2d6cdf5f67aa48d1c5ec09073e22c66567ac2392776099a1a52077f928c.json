  "query": "SELECT id, user_id, title, content, last_edited_by, \n                      is_favorited, is_archived, is_deleted, created_at, updated_at \n               FROM notes \n               WHERE user_id = $1 AND is_deleted = false\n               ORDER BY updated_at DESC\n               LIMIT $2 OFFSET $3",
