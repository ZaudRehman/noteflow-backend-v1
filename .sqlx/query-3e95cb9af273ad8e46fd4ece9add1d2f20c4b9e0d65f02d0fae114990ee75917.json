{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                n.id, \n                n.title, \n                n.content, \n                n.last_edited_by,\n                n.is_favorited,\n                n.is_archived,\n                n.created_at, \n                n.updated_at\n            FROM notes n\n            INNER JOIN note_tags nt ON n.id = nt.note_id\n            WHERE nt.tag_id = $1 \n                AND n.user_id = $2 \n                AND n.is_deleted = false\n            ORDER BY n.updated_at DESC\n            LIMIT $3 OFFSET $4\n            ",
